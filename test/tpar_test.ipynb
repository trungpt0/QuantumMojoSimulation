   "source": [
    "from qiskit import QuantumCircuit\n",
    "\n",
    "qc = QuantumCircuit(4)\n",
    "\n",
    "qc.t(0)\n",
    "qc.cx(0, 1)\n",
    "qc.cx(2, 3)\n",
    "qc.t(3)\n",
    "qc.cx(2, 3)\n",
    "qc.cx(1, 2)\n",
    "qc.cx(1, 0)\n",
    "qc.cx(3, 2)\n",
    "qc.cx(1, 2)\n",
    "qc.cx(0, 1)\n",
    "qc.t(2)\n",
    "qc.tdg(1)\n",
    "\n",
    "print(qc.draw(output=\"text\", fold=-1))"
   ]
