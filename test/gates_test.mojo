from circuit import QuantumCircuit
from qmath import PI

def main() raises:
    var qc = QuantumCircuit(2)
    qc.X_test()
    qc.Y_test()
    qc.Z_test()
    qc.H_test()
    qc.S_test()
    qc.T_test()
    qc.RX_test(PI)
    qc.RY_test(PI)
    qc.RZ_test(PI)
    qc.P_test(PI)
    qc.IP_test(PI)
    qc.SX_test()
    qc.V_test()
    qc.CX_test()
    qc.CY_test()
    qc.CZ_test()
    qc.SWAP_test()
    qc.ECR_test()
    qc.RBS_test(PI)
    qc.CP_test(PI)
    qc.CRX_test(PI)
    qc.CRY_test(PI)
    qc.CRZ_test(PI)
    var qc1 = QuantumCircuit(3)
    qc1.CCX_test()
    qc1.CCY_test()
    qc1.CCZ_test()